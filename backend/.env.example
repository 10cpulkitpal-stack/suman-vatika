PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=file:./data/suman-vatika.db

# Production uses Supabase Storage; local development stores uploads on disk.
GALLERY_STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_GALLERY_BUCKET=gallery
PUBLIC_API_URL=http://localhost:4000

# Set a unique password and a random signing secret with at least 32 characters.
ADMIN_PASSWORD=replace-with-a-strong-unique-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional: enables Bearer-token access to private admin APIs for trusted tools.
ADMIN_API_KEY=replace-with-a-long-random-secret
